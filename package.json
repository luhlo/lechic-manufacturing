{
  "name": "lechic-manufacturing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "build": "vite build && node scripts/static-routes.mjs && node scripts/precache.mjs && node scripts/verify-static.mjs",
    "start": "vite preview",
    "lint": "eslint . --ignore-pattern dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "preview:pages": "wrangler pages dev dist --ip 127.0.0.1 --port 5175 --inspector-port 0 --compatibility-date 2026-05-22",
    "test:static-browser": "node tests/static-browser-qa.mjs"
  },
