    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "vitest": "5.0.2",
    "@electric-sql/pglite": "0.5.8",
    "supabase": "2.118.0",
    "typescript-eslint": "8.59.3",
